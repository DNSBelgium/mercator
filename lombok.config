# This file is the root of the project for Lombok's config resolution
config.stopBubbling = true

# The project has migrated to Jackson 3 (tools.jackson). Jackson 2 (com.fasterxml)
# is still on the classpath because it is pulled in transitively by com.maxmind.geoip2
# (geoip2 -> jackson-databind + jackson-datatype-jsr310). With both Jackson 2 and 3
# present, @Jacksonized can't tell which variant to generate, so pin it to Jackson 3.
# This is a LIST config key (Jackson major version(s)), so it must use '+='.
# See https://projectlombok.org/features/experimental/Jacksonized
lombok.jacksonized.jacksonVersion += 3



