        </dependency>

        <!-- Used in GeoIPServiceImpl  -->
        <!-- Transitive dependency of testcontainers is affected by -->
        <!--  https://cve.mitre.org/cgi-bin/cvename.cgi?name=CVE-2024-26308 -->
