    </licenses>
    <properties>
        <java.version>25</java.version>
        <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
        <maven.compiler.proc>full</maven.compiler.proc>
        <argLine/>
        <!-- Override Spring Boot 4.1.1 managed versions (Boot default shown in comments). -->
        <netty.version>4.2.17.Final</netty.version>   <!-- Boot: 4.2.17.Final -->
        <tomcat.version>11.0.25</tomcat.version>       <!-- Boot: 11.0.24 -->
        <xmlunit2.version>2.13.0</xmlunit2.version>    <!-- Boot: 2.11.0 (CVE fix) -->
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Pin transitive jackson-databind to patched versions (Snyk gate).
                 Jackson 2.x (com.fasterxml) is pulled in transitively by geoip2;
                 Jackson 3.x (tools.jackson) is managed by the Spring Boot 4.1.1 parent.
                 Both are same-minor patch bumps that close the reported deserialization/
                 unsafe-reflection advisories. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.21.6</version>
            </dependency>
            <dependency>
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>3.1.6</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- https://mvnrepository.com/artifact/org.springframework/spring-jdbc -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <!-- This will automagically find the DuckDB JDBC driver in the classpath and register it with the DriverManager. -->
        <!-- No need to create a DuckDataSource class ... -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Postgres driver for the stateful work queue (postgres-queue profile) and tests -->
